{
  "schemaVersion": 1,
  "id": "observercam",
  "version": "${version}",
  "name": "Observer Cam",
  "description": "An autonomous in-world Observer cameraman.",
  "authors": ["Observer Cam contributors"],
  "license": "MIT",
  "icon": "assets/observercam/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.fluffybacon.observercam.ObserverCam"],
    "client": ["com.fluffybacon.observercam.client.ObserverCamClient"],
    "modmenu": ["com.fluffybacon.observercam.client.ObserverCamModMenu"]
  },
  "mixins": [
    {
      "config": "observercam.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=17.0.0-beta.2"
  }
}
