{
  "schemaVersion": 1,
  "id": "observercam",
  "version": "${version}",
  "name": "Observer Cam",
  "description": "An autonomous documentary-style Observer cameraman with live POV, recording, instant replay, and picture-in-picture.",
  "authors": ["FluffyBacon678"],
  "contact": {
    "homepage": "https://github.com/FluffyBacon678/Minecraft--Observer-mod",
    "sources": "https://github.com/FluffyBacon678/Minecraft--Observer-mod",
    "issues": "https://github.com/FluffyBacon678/Minecraft--Observer-mod/issues"
  },
  "license": "MIT",
  "icon": "assets/observercam/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.fluffybacon.observercam.ObserverCam"],
    "client": ["com.fluffybacon.observercam.client.ObserverCamClient"],
    "modmenu": ["com.fluffybacon.observercam.client.ObserverCamModMenu"]
  },
  "mixins": [
    {
      "config": "observercam.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.2"
  },
  "suggests": {
    "modmenu": ">=17.0.0-beta.2"
  }
}
